rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - currentWeek: number (required, 1-31)
    //   - remindersEnabled: bool (required)
    //   - reminderTime: string (required, HH:mm format)
    //
    // Collection: users/{userId}/entries
    // Document ID: {entryId} (Auto-generated)
    // Fields:
    //   - date: string (required, ISO 8601)
    //   - type: string (required, 'morning'|'evening'|'weekend')
    //   - completions: list (required, max 10 stems)
    //     - stem: string
    //     - endings: list (strings, max 10)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "guruprasadjoshi6@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Domain Validators
    function isValidUserProgress(data) {
      return hasOnlyAllowedFields(['currentWeek', 'remindersEnabled', 'reminderTime', 'completedChapters']) &&
             data.currentWeek is int && data.currentWeek >= 1 && data.currentWeek <= 31 &&
             data.remindersEnabled is bool &&
             data.reminderTime is string && data.reminderTime.matches("^\\d{2}:\\d{2}$") &&
             data.completedChapters is list;
    }

    function isValidEntry(data) {
      return hasRequiredFields(['date', 'type', 'completions']) &&
             data.date is string &&
             data.type in ['morning', 'evening', 'weekend'] &&
             data.completions is list && data.completions.size() <= 10;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProgress(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProgress(request.resource.data);
      allow delete: if false; // No one can delete users for now, or only admin via console

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEntry(request.resource.data);
        allow update: if isOwner(userId) && isValidEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /test/{doc} {
      allow read: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
